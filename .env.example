# SmartSQLQuery — environment variable template
# Copy to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# ---- SQLite paths (defaults to data/*.db relative to repo root) ----
# Override only if you store the DB files outside the repo.
# SMARTSQL_UNIVERSITY_PATH=/absolute/path/to/university.db
# SMARTSQL_ECOMMERCE_PATH=/absolute/path/to/ecommerce.db
# SMARTSQL_HR_PATH=/absolute/path/to/hr_analytics.db

# ---- MySQL optional (T-1.02) ----
# Un-comment and fill in to test MySQL dialect.
# MYSQL_DSN=mysql+pymysql://user:password@localhost:3306/smartsql

# ---- LLM provider keys (Phase 3) ----
# Choose ONE cloud provider and fill in its key.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# ---- Agent settings (Phase 3) ----
# SMARTSQL_LLM_PROVIDER=gemini
# SMARTSQL_RETRY_LIMIT=3
# SMARTSQL_DEFAULT_LIMIT=100
# SMARTSQL_MAX_LIMIT=1000

# ---- Ollama (Phase 3, optional local) ----
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Environment flag ----
SMARTSQL_ENV=development
