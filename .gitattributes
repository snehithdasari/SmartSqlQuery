# Normalize line endings to LF in the repo; checkout as native on each OS
* text=auto eol=lf

# Force LF for YAML (GitHub Actions requires LF)
*.yml  text eol=lf
*.yaml text eol=lf

# Force LF for Python
*.py   text eol=lf

# Markdown
*.md   text eol=lf

# Binary — no conversion
*.db   binary
*.so   binary
